.page{padding:24rpx}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:22rpx}.title{font-size:42rpx;font-weight:700}.hint{font-size:24rpx;color:#627089;margin-top:8rpx}.add,.save{background:#5268f4;color:#fff}.board{background:#fff;border-radius:20rpx;box-shadow:0 6rpx 20rpx #24365618}.grid{display:grid;grid-template-columns:110rpx repeat(7,160rpx);min-width:1230rpx;position:relative}.time-head,.day-head{height:72rpx;background:#17243b;color:#fff;text-align:center;line-height:72rpx;font-weight:700}.time-col{grid-column:1}.time{height:112rpx;background:#e8fbfb;color:#107b80;font-size:24rpx;padding:12rpx;border-bottom:1rpx solid #dce3ee}.day-col{position:relative}.slot{height:112rpx;border-right:1rpx solid #dce3ee;border-bottom:1rpx solid #dce3ee}.event{position:absolute;left:6rpx;right:6rpx;border-radius:10rpx;padding:10rpx;color:#fff;font-size:22rpx;z-index:2;overflow:hidden}.event-title{font-size:26rpx;font-weight:700}.class{background:#ed8b17}.task{background:#5268f4}.personal{background:#18a88a}.reset{margin-top:22rpx;background:#fff;color:#17243b;border:1rpx solid #dce3ee}.mask{position:fixed;inset:0;background:#17243b88;display:flex;align-items:flex-end}.editor{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:32rpx}.editor-title{font-size:34rpx;font-weight:700;margin-bottom:20rpx}.editor input,.editor textarea,.picker{border:1rpx solid #dce3ee;border-radius:12rpx;padding:20rpx;margin:12rpx 0;font-size:28rpx}.editor textarea{width:calc(100% - 40rpx);height:110rpx}.row{display:flex;gap:10rpx}.row picker{flex:1}.actions{display:flex;justify-content:flex-end;gap:14rpx;margin-top:20rpx}.actions button{margin:0}.delete{color:#cf3756;background:#fff0f3}