<view class="page">
  <view class="top"><view><view class="title">我的周日程表</view><view class="hint">点按空白时间格新增，点按事项编辑</view></view><button class="add" bindtap="openNew">＋ 新增</button></view>
  <scroll-view class="board" scroll-x="true"><view class="grid"><view class="time-head">时间</view><block wx:for="{{days}}" wx:key="*this"><view class="day-head">{{item}}</view></block><view class="time-col"><block wx:for="{{slots}}" wx:key="*this"><view class="time">{{item < 10 ? '0' + item : item}}:00\n{{item < 10 ? '0' + item : item}}:50</view></block></view><block wx:for="{{days}}" wx:for-index="dayIndex" wx:key="*this"><view class="day-col"><block wx:for="{{slots}}" wx:for-item="hour" wx:key="*this"><view class="slot" data-day="{{dayIndex}}" data-hour="{{hour}}" bindtap="openNew"></view></block><block wx:for="{{events}}" wx:key="id"><view wx:if="{{item.day === dayIndex}}" class="event {{item.type}}" style="top: {{(item.start - 8) * 112}}rpx; height: {{(item.end - item.start) * 112 - 12}}rpx;" data-id="{{item.id}}" bindtap="openEdit"><view class="event-title">{{item.title}}</view><view>{{item.note}}</view></view></block></view></block></view></scroll-view>
  <button class="reset" bindtap="resetSchoolCourses">恢复学校原始课程</button>
  <view class="mask" wx:if="{{showEditor}}"><view class="editor"><view class="editor-title">{{isEditing ? '编辑安排' : '新增安排'}}</view><input placeholder="事项名称" value="{{form.title}}" data-field="title" bindinput="input"/><textarea placeholder="地点／备注" value="{{form.note}}" data-field="note" bindinput="input"/><view class="row"><picker range="{{dayOptions}}" value="{{form.day}}" bindchange="chooseDay"><view class="picker">{{dayOptions[form.day]}}</view></picker><picker range="{{hourOptions}}" value="{{form.start - 8}}" bindchange="chooseStart"><view class="picker">{{hourOptions[form.start - 8]}}</view></picker><picker range="{{hourOptions}}" value="{{form.end - 9}}" bindchange="chooseEnd"><view class="picker">{{hourOptions[form.end - 9]}}</view></picker></view><picker range="{{['任务','个人','课程']}}" value="{{typeIndex}}" bindchange="chooseType"><view class="picker">类型：{{form.type === 'class' ? '课程' : form.type === 'personal' ? '个人' : '任务'}}</view></picker><view class="actions"><button wx:if="{{isEditing}}" class="delete" bindtap="deleteEvent">删除</button><button bindtap="closeEditor">取消</button><button class="save" bindtap="saveEvent">保存</button></view></view></view>
</view>